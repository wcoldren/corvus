{
  "language": "la",
  "lesson": 2,
  "unit": 1,
  "title": "The first declension and the five cases",
  "cards": [
    {
      "id": "la-02-c-declension",
      "type": "concept",
      "prompt": "What is a declension?",
      "answer": "A family of nouns that share the same set of endings.",
      "tags": [
        "concept"
      ]
    },
    {
      "id": "la-02-c-nominative",
      "type": "concept",
      "prompt": "What job does the **nominative** case do?",
      "answer": "The subject of the sentence.",
      "tags": [
        "concept",
        "cases"
      ]
    },
    {
      "id": "la-02-c-genitive",
      "type": "concept",
      "prompt": "What job does the **genitive** case do?",
      "answer": "\"Of\": it links the noun to another noun (possession, belonging).",
      "tags": [
        "concept",
        "cases"
      ]
    },
    {
      "id": "la-02-c-dative",
      "type": "concept",
      "prompt": "What job does the **dative** case do?",
      "answer": "\"To/for\": usually the indirect object.",
      "tags": [
        "concept",
        "cases"
      ]
    },
    {
      "id": "la-02-c-accusative",
      "type": "concept",
      "prompt": "What job does the **accusative** case do?",
      "answer": "The direct object (and the object of some prepositions).",
      "tags": [
        "concept",
        "cases"
      ]
    },
    {
      "id": "la-02-c-ablative",
      "type": "concept",
      "prompt": "What job does the **ablative** case do?",
      "answer": "\"By/with/from/in\", usually after a preposition.",
      "tags": [
        "concept",
        "cases"
      ]
    },
    {
      "id": "la-02-c-decl1-gender",
      "type": "concept",
      "prompt": "First-declension nouns (like *aqua*) are almost all which gender?",
      "answer": "Feminine.",
      "tags": [
        "concept",
        "decl-1"
      ]
    },
    {
