{
  "language": "la",
  "lesson": 1,
  "unit": 1,
  "title": "Endings vs word order; the accusative -m; element names",
  "cards": [
    {
      "id": "la-01-c-endings-vs-order",
      "type": "concept",
      "prompt": "In Latin, what tells you who does what to whom: word order or endings?",
      "answer": "Endings. Word order is flexible; the endings carry the grammar.",
      "notes": "*Deus hominem amat* = *Hominem Deus amat*.",
      "tags": [
        "concept"
      ]
    },
    {
      "id": "la-01-c-accusative-m",
      "type": "concept",
      "prompt": "What does the ending **-m** usually mark on a noun (as in *Deum*, *hominem*)?",
      "answer": "The direct object (accusative singular).",
      "tags": [
        "concept",
        "accusative"
      ]
    },
    {
      "id": "la-01-p-hominem-deus-amat",
      "type": "phrase",
      "prompt": "Hominem Deus amat.",
      "answer": "God loves the human being.",
      "notes": "*hominem* has the object ending -m, so it is loved, even though it comes first.",
      "tags": [
        "phrase"
      ]
    },
    {
      "id": "la-01-p-ora-et-labora",
      "type": "phrase",
      "prompt": "Ōrā et labōrā.",
      "answer": "Pray and work.",
      "notes": "Benedictine motto. OH-rah et lah-BOH-rah.",
      "tags": [
        "phrase"
      ]
    },
    {
