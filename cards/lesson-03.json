{
  "language": "la",
  "lesson": 3,
  "unit": 1,
  "title": "The second declension: masculine -us and neuter -um",
  "cards": [
    {
      "id": "la-03-c-decl2-endings",
      "type": "concept",
      "prompt": "Second-declension nouns end in what in the nominative singular, and which genders go with each?",
      "answer": "-us (mostly masculine) and -um (neuter).",
      "notes": "Also -er/-ir masculines (*puer, ager, vir, liber, magister*), coming later.",
      "tags": [
        "concept",
        "decl-2"
      ]
    },
    {
      "id": "la-03-c-neuter-rule",
      "type": "concept",
      "prompt": "What is the neuter rule?",
      "answer": "Nominative and accusative are always identical, and in the plural both end in -a. True in every declension.",
      "tags": [
        "concept",
        "neuter"
      ]
    },
    {
      "id": "la-03-c-find-stem",
      "type": "concept",
      "prompt": "How do you find a noun's stem?",
      "answer": "Take the genitive singular from the dictionary entry and drop its ending: *ferrum, ferrī* → *ferr-*.",
      "notes": "That stem is what chemistry builds on: ferrous, ferric, ferrocene.",
      "tags": [
        "concept",
        "chemistry"
      ]
    },
    {
      "id": "la-03-v-dominus",
      "type": "vocab",
      "prompt": "dominus, dominī, m.",
      "answer": "lord",
      "reverse": true,
      "accept": [
        "master"
