    {
      "id": "la-03-v-caelum",
      "type": "vocab",
      "prompt": "caelum, caelī, n. (pl. caelī, m.)",
      "answer": "heaven",
      "reverse": true,
      "accept": [
        "sky"
      ],
      "notes": "CHEH-loom: *c* before *ae* is \"ch\". Neuter in the singular, masculine in the plural: caelī, caelōrum, caelīs, caelōs. *Caelī ēnārrant glōriam Deī* (Ps 18:2).",
      "tags": [
        "vocab",
        "decl-2"
      ]
    },
